{
	"name": "Ubuntu",
	"build": { "dockerfile": "Dockerfile" },

  // A Docker engine of this container's own, never the Mac's, which runs Inkproof's
  // production kit. Moby has no packages for Ubuntu resolute, so this installs Docker CE.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": { "moby": false }
  },

  // Without it Docker creates the bind mount's source as root, and vscode can't write it.
  "initializeCommand": "mkdir -p ${localEnv:HOME}/.claude-devcontainer",

  // The reference is cloned beside the workspace. /workspaces is mounted at run time, as
  // root's, so a chown in the Dockerfile would be hidden.
  "postCreateCommand": "sudo chown vscode:vscode /workspaces",

  // Store Claude's persistent state on the host
  "mounts": [
    "source=${localEnv:HOME}/.claude-devcontainer,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=elan-shared,target=/home/vscode/.elan,type=volume"
  ],

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "safe.directory",
    "GIT_CONFIG_VALUE_0": "${containerWorkspaceFolder}"
  },

	"customizations": {
		"vscode": {
			"extensions": ["leanprover.lean4", "anthropic.claude-code"]
		}
	}
}
