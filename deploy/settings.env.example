# Inkproof's deployment settings, for the guild's scripts as KIT_ENV. Copy it to settings.env at
# the checkout's root, which git ignores, and edit. The guild's docs/DEPLOYING.md says what each
# setting does and its default.

FORGE_ORG=tentenths
HUMAN_USER=paulbutcher
HUMAN_EMAIL=you@example.com
FORGE_PORT=3000
FORGE_WEB_URL=http://localhost:3000

# The reference's names, which its volumes, every repository's checks.yml and the agents'
# workspaces hold, so that the guild's kit runs on the reference's data.
COMPOSE_PROJECT_NAME=inkproof-forge
CI_IMAGE=inkproof-ci:1
TOOLCHAIN_VOLUME=inkproof-elan
# npm's cache for CI jobs, which the reference didn't have: a name of Inkproof's own.
NPM_CACHE_VOLUME=inkproof-npm
REQUIRE_LASM_VAR=INKPROOF_REQUIRE_LASM
WORKSPACE_STATE=.inkproof

# Holds secrets/, control/, backups/ and proxy/; relative to this file. At the switch, a
# copy of the reference checkout's.
STATE_DIR=state

# The Mac: its user, which owns STATE_DIR, and its resources.
HOST_UID=501
HOST_GID=20
AGENT_MEMORY=16g
AGENT_PIDS=4096
AGENT_CPUS=6
CI_MEMORY=24g
CI_CPUS=8
DISPATCHER_MEMORY=2g
